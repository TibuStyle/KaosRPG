# Copia a .env. Nunca publiques .env ni la clave real.
PORT=3000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HOPS=0
GEMINI_API_KEY=
# Modelo solicitado; verificar disponibilidad en Google antes del despliegue.
GEMINI_MODEL=gemini-1.5-flash
# Servicio externo sin credenciales según el endpoint solicitado; verificar disponibilidad/condiciones.
# false desactiva retratos (sin bloquear aprobación ni turnos).
POLLINATIONS_ENABLED=true

# Ruta local; conservar en volumen persistente. No compartir entre instancias.
SQLITE_PATH=./data/cronicas.sqlite

