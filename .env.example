NODE_ENV=development
PORT=3000
# Orígenes exactos, SIN ruta ni barra final. No usar *.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Producción: incluir https://usuario.github.io y el origen del backend.
# Ajustar solo si se conoce el número de proxies de confianza:
TRUST_PROXY_HOPS=0
