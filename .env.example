# Copia a .env. Nunca publiques .env ni la clave real.
PORT=3000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HOPS=0
OPENAI_API_KEY=
# Modelo compatible con Structured Outputs (json_schema strict).
OPENAI_MODEL=gpt-4o-mini

# Ruta local; conservar en volumen persistente. No compartir entre instancias.
SQLITE_PATH=./data/cronicas.sqlite
